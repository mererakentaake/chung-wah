rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions — each user reads/writes only their own
    match /sessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // FCM tokens — each user reads/writes only their own
    match /fcmTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Admins — any authenticated user can read (needed for login check).
    // Writes are otherwise blocked (an authenticated user must never be able
    // to self-provision admin status by creating/editing an admins/{uid}
    // doc) — the one exception is an existing admin updating their OWN
    // photoUrl from the Profile screen.
    match /admins/{docId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == docId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl']);
      allow create, delete: if false;
    }

    // Accounts users — authenticated users can read/write
    match /accountsUsers/{docId} {
      allow read, write: if request.auth != null;
    }

    // Pre-registration data
    match /Login/{type}/users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Everything else — authenticated users only
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
