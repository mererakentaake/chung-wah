rules_version = '2';

// NOTE: this project previously had no storage.rules file at all, which
// means the Firebase Storage bucket was left on whatever default rules
// were set in the console (commonly "deny all"). That silently breaks
// every upload (e.g. profile photos) — often *hanging* rather than
// cleanly failing, since some clients don't surface a permission error
// until their retry/backoff window elapses. Deploy this alongside
// firestore.rules (`firebase deploy --only storage`) to fix that.
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: schools/{schoolCode}/profiles/{userId}
    // NOTE: {userId} here is this app's own Firestore doc id (see
    // AuthContext/auth.js), which is NOT the same as request.auth.uid for
    // students/teachers/parents (only Admin/Accounts happen to use their
    // Firebase Auth uid as their app userId). An exact-match check against
    // request.auth.uid would therefore incorrectly block most roles, so —
    // consistent with this app's existing permissive Firestore rules —
    // any authenticated user may read/write here.
    match /schools/{schoolCode}/profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else — authenticated users only (mirrors firestore.rules'
    // permissive default for this single-school app).
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
