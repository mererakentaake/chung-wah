# .env.example — copy to .env.local and fill in your Firebase project values
# Get these from: Firebase Console > Project Settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# File uploads (profile photos, assignments, announcements) use Cloudinary's
# free tier instead of Firebase Storage, since Firebase Storage now requires
# a paid Blaze plan (linked card) even for no-cost usage.
# Get these from: Cloudinary Dashboard (cloud name) and
# Settings > Upload > Upload presets (create an UNSIGNED preset).
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name_here
